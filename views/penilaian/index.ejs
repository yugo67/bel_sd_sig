<% layout('layouts/main') %>
<% const currentPage = 'penilaian' %>

<div class="content-page">
  <div class="container-fluid px-4">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
      <div>
        <h4 class="mb-1"><i class="bi bi-clipboard2-data-fill me-2 text-success"></i>Jurnal Penilaian Harian</h4>
        <p class="text-muted mb-0">Input, kelola, dan ekspor hasil penilaian harian siswa</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/penilaian/export?kelas_id=<%= kelasId %>&mapel_id=<%= mapelId %>&tanggal=<%= tanggal %>" class="btn btn-success">
          <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
        </a>
        <a href="/penilaian/rekap" class="btn btn-outline-info">
          <i class="bi bi-graph-up me-1"></i>Rekap Nilai
        </a>
        <a href="/penilaian/input" class="btn btn-primary">
          <i class="bi bi-plus-lg me-1"></i>Input Nilai
        </a>
      </div>
    </div>

    <!-- Filter -->
    <div class="card-custom mb-4">
      <div class="card-custom-body">
        <form method="GET" action="/penilaian" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label fw-semibold">Kelas</label>
            <select class="form-select" name="kelas_id">
              <option value="">-- Semua Kelas --</option>
              <% for (const k of kelasList) { %>
              <option value="<%= k.id %>" <%= kelasId == k.id ? 'selected' : '' %>><%= k.nama_kelas %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Mata Pelajaran</label>
            <select class="form-select" name="mapel_id">
              <option value="">-- Semua Mapel --</option>
              <% for (const mp of mapelList) { %>
              <option value="<%= mp.id %>" <%= mapelId == mp.id ? 'selected' : '' %>><%= mp.nama %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-semibold">Tanggal</label>
            <input type="date" class="form-control" name="tanggal" value="<%= tanggal %>">
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-search me-1"></i>Filter
            </button>
          </div>
          <div class="col-md-2">
            <a href="/penilaian" class="btn btn-outline-secondary w-100">Reset</a>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabel Penilaian -->
    <div class="card-custom">
      <div class="card-custom-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Data Penilaian (<%= penilaianList.length %>)</h5>
        <% if (penilaianList.length > 0) { %>
        <a href="/penilaian/export?kelas_id=<%= kelasId %>&mapel_id=<%= mapelId %>&tanggal=<%= tanggal %>" class="btn btn-sm btn-outline-success">
          <i class="bi bi-download me-1"></i>Download Excel
        </a>
        <% } %>
      </div>
      <div class="card-custom-body p-0">
        <% if (penilaianList.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-clipboard2-x fs-1 d-block mb-2"></i>
          Belum ada data penilaian. <a href="/penilaian/input">Input nilai baru</a>.
        </div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Tanggal</th>
                <th>Siswa</th>
                <th>Kelas</th>
                <th>Mata Pelajaran</th>
                <th>Jenis</th>
                <th>Judul</th>
                <th class="text-center">Nilai</th>
                <th>Guru</th>
              </tr>
            </thead>
            <tbody>
              <% for (const p of penilaianList) { %>
              <% const pct = (p.nilai / p.nilai_max) * 100 %>
              <tr>
                <td><%= new Date(p.tanggal).toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric'}) %></td>
                <td>
                  <strong><%= p.nama_siswa %></strong>
                  <br><small class="text-muted"><%= p.nis %></small>
                </td>
                <td><span class="badge bg-primary"><%= p.nama_kelas %></span></td>
                <td><%= p.nama_mapel %></td>
                <td><span class="badge bg-<%= {tugas:'secondary',kuis:'info',ulangan_harian:'warning text-dark',praktik:'success',proyek:'purple'}[p.jenis_penilaian] || 'secondary' %>"><%= p.jenis_penilaian.replace('_', ' ') %></span></td>
                <td><%= p.judul %></td>
                <td class="text-center">
                  <strong class="fs-5 text-<%= pct >= 75 ? 'success' : pct >= 60 ? 'warning' : 'danger' %>"><%= p.nilai %></strong>
                  <small class="text-muted d-block">/ <%= p.nilai_max %></small>
                </td>
                <td><small><%= p.nama_guru %></small></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
