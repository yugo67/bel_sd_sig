<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/img/bell-icon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- Sidebar -->
<nav id="sidebar" class="sidebar">
  <div class="sidebar-header">
    <a href="/dashboard" class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <i class="bi bi-bell-fill"></i>
      </div>
      <div class="sidebar-brand-text">
        <span class="brand-name">SD SIG</span>
        <span class="brand-sub">Sistem Informasi</span>
      </div>
    </a>
    <button class="btn sidebar-toggle-btn d-lg-none" id="sidebarClose" title="Tutup Menu">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <div class="sidebar-user">
    <div class="sidebar-avatar" title="<%= user ? user.nama : 'User' %>">
      <% if (user && user.foto) { %>
        <img src="/uploads/foto/<%= user.foto %>" alt="Foto">
      <% } else { %>
        <i class="bi bi-person-fill"></i>
      <% } %>
    </div>
    <div class="sidebar-user-info">
      <strong><%= user ? user.nama : 'Guest' %></strong>
      <span class="badge <%= user && user.role === 'admin' ? 'bg-danger' : 'bg-info' %>">
        <%= user ? user.role.toUpperCase() : '' %>
      </span>
    </div>
  </div>

  <ul class="sidebar-menu">
    <li class="sidebar-label">Menu Utama</li>
    <li>
      <a href="/dashboard" class="<%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>" title="Dashboard">
        <i class="bi bi-speedometer2"></i>
        <span>Dashboard</span>
      </a>
    </li>

    <li class="sidebar-label">🔔 Bel Sekolah</li>
    <li>
      <a href="/bel" class="<%= typeof currentPage !== 'undefined' && currentPage === 'bel' ? 'active' : '' %>" title="Jadwal Bel">
        <i class="bi bi-alarm-fill"></i>
        <span>Jadwal Bel</span>
      </a>
    </li>
    <li>
      <a href="/bel/suara" class="<%= typeof currentPage !== 'undefined' && currentPage === 'suara' ? 'active' : '' %>" title="Suara Bel">
        <i class="bi bi-music-note-beamed"></i>
        <span>Suara Bel</span>
      </a>
    </li>

    <li class="sidebar-label">📚 Akademik</li>
    <li>
      <a href="/jadwal-pelajaran" class="<%= typeof currentPage !== 'undefined' && currentPage === 'jadwal-pelajaran' ? 'active' : '' %>" title="Jadwal Pelajaran">
        <i class="bi bi-calendar3"></i>
        <span>Jadwal Pelajaran</span>
      </a>
    </li>
    <li>
      <a href="/kelas" class="<%= typeof currentPage !== 'undefined' && currentPage === 'kelas' ? 'active' : '' %>" title="Data Kelas">
        <i class="bi bi-building"></i>
        <span>Data Kelas</span>
      </a>
    </li>
    <li>
      <a href="/siswa" class="<%= typeof currentPage !== 'undefined' && currentPage === 'siswa' ? 'active' : '' %>" title="Data Siswa">
        <i class="bi bi-mortarboard-fill"></i>
        <span>Data Siswa</span>
      </a>
    </li>
    <li>
      <a href="/absensi" class="<%= typeof currentPage !== 'undefined' && currentPage === 'absensi' ? 'active' : '' %>" title="Absensi Siswa">
        <i class="bi bi-person-check-fill"></i>
        <span>Absensi Siswa</span>
      </a>
    </li>
    <li>
      <a href="/jurnal" class="<%= typeof currentPage !== 'undefined' && currentPage === 'jurnal' ? 'active' : '' %>" title="Jurnal Pembelajaran">
        <i class="bi bi-journal-text"></i>
        <span>Jurnal Pembelajaran</span>
      </a>
    </li>
    <li>
      <a href="/penilaian" class="<%= typeof currentPage !== 'undefined' && currentPage === 'penilaian' ? 'active' : '' %>" title="Penilaian Harian">
        <i class="bi bi-clipboard2-data-fill"></i>
        <span>Penilaian Harian</span>
      </a>
    </li>

    <% if (user && user.role === 'admin') { %>
    <li class="sidebar-label">⚙️ Admin</li>
    <li>
      <a href="/users" class="<%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'active' : '' %>" title="Manajemen Pengguna">
        <i class="bi bi-people-fill"></i>
        <span>Manajemen Pengguna</span>
      </a>
    </li>
    <% } %>
  </ul>

  <div class="sidebar-footer">
    <a href="/auth/logout" class="sidebar-logout" title="Keluar">
      <i class="bi bi-box-arrow-left"></i>
      <span>Keluar</span>
    </a>
  </div>
</nav>

<!-- Overlay untuk mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Main Content -->
<div class="main-wrapper" id="mainWrapper">
  <!-- Topbar -->
  <header class="topbar">
    <button class="btn topbar-toggle-btn" id="sidebarToggle">
      <i class="bi bi-list"></i>
    </button>
    <div class="topbar-title d-none d-md-block">
      <h5 class="mb-0"><%= title %></h5>
    </div>
    <div class="topbar-right">
      <!-- Jam digital -->
      <div class="topbar-clock" id="topbarClock">
        <i class="bi bi-clock"></i>
        <span id="clockDisplay">00:00:00</span>
      </div>
      <!-- Bel Manual -->
      <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalBelManual" title="Bunyikan Bel Manual">
        <i class="bi bi-bell-fill me-1"></i>
        <span class="d-none d-md-inline">Bel Manual</span>
      </button>
    </div>
  </header>

  <!-- Content -->
  <main class="main-content">
    <!-- Flash Messages -->
    <% if (successMsg && successMsg.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show mx-3 mt-3" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i><%= successMsg[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>
    <% if (errorMsg && errorMsg.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMsg[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <%- body %>
  </main>
</div>

<!-- Modal Bel Manual -->
<div class="modal fade" id="modalBelManual" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-warning">
        <h5 class="modal-title fw-bold">
          <i class="bi bi-bell-fill me-2"></i>Bunyikan Bel Manual
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <div class="mb-3">
          <label class="form-label fw-semibold">Pilih Suara Bel</label>
          <select class="form-select" id="manualSuaraBelId">
            <option value="">-- Tidak ada suara --</option>
            <!-- Diisi via AJAX -->
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Keterangan</label>
          <input type="text" class="form-control" id="manualKeterangan" placeholder="Keterangan bel manual (opsional)">
        </div>
        <div id="belManualPreview" class="d-none">
          <audio id="previewAudio" controls class="w-100 mb-2"></audio>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-warning fw-bold" id="btnBunyikanBel">
          <i class="bi bi-bell-fill me-2"></i>Bunyikan Bel!
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Toast Notifikasi Bel -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
  <div id="belToast" class="toast border-0 shadow-lg" role="alert" data-bs-autohide="false">
    <div class="toast-header bg-warning border-0">
      <i class="bi bi-bell-fill me-2 text-dark"></i>
      <strong class="me-auto text-dark">🔔 BEL SEKOLAH</strong>
      <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
    </div>
    <div class="toast-body fw-semibold fs-6" id="belToastBody">
      Bel sedang berbunyi!
    </div>
  </div>
</div>

<audio id="belAudio" preload="none"></audio>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
