<% layout('layouts/main') %>
<% const currentPage = 'absensi' %>

<div class="content-page">
  <div class="container-fluid px-3 px-md-4">
    <!-- Page Header -->
    <div class="page-header d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
      <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-person-check-fill text-primary me-2"></i>Jurnal Absensi Siswa</h4>
        <p class="text-muted mb-0">Catat dan kelola kehadiran harian siswa per kelas</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <a href="/absensi/rekap" class="btn btn-outline-primary fw-semibold">
          <i class="bi bi-bar-chart-fill me-1"></i>Rekap Absensi Bulanan
        </a>
      </div>
    </div>

    <!-- Banner Jadwal Mengajar Hari Ini (Jika ada jadwal mengajar guru login) -->
    <% if (typeof jadwalHariIni !== 'undefined' && jadwalHariIni.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4 text-white" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); border-radius: 14px;">
      <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3">
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white text-primary px-2.5 py-1 fw-bold text-uppercase"><%= hariNama %></span>
            <h6 class="fw-bold mb-0 text-white"><i class="bi bi-clock-history me-2"></i>Jadwal Mengajar Anda Hari Ini</h6>
          </div>
          <span class="badge bg-warning text-dark fw-bold px-3 py-1"><%= jadwalHariIni.length %> Jam Pelajaran</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% for (const j of jadwalHariIni) { %>
          <a href="/absensi?kelas_id=<%= j.kelas_id %>&tanggal=<%= tanggal %>" 
             class="btn btn-sm <%= kelasId == j.kelas_id ? 'btn-light text-primary fw-bold shadow-sm' : 'btn-outline-light' %> d-inline-flex align-items-center gap-2">
            <i class="bi bi-door-open-fill"></i>
            <span><strong><%= j.nama_kelas %></strong> • <%= j.nama_mapel %> (<%= j.jam_mulai.slice(0,5) %> - <%= j.jam_selesai.slice(0,5) %>)</span>
          </a>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Filter Card -->
    <div class="card-custom mb-4 shadow-sm border-0">
      <div class="card-custom-body py-3 px-3 px-md-4">
        <form method="GET" action="/absensi" class="row g-3 align-items-end">
          <div class="col-md-5 col-lg-4">
            <label class="form-label fw-semibold text-secondary small mb-1">
              <i class="bi bi-building me-1 text-primary"></i>Pilih Kelas
            </label>
            <select class="form-select" name="kelas_id" onchange="this.form.submit()">
              <option value="">-- Pilih Kelas --</option>
              <% for (const k of kelasList) { %>
              <option value="<%= k.id %>" <%= kelasId == k.id ? 'selected' : '' %>>
                <%= k.nama_kelas %> (Tingkat <%= k.tingkat %>)
              </option>
              <% } %>
            </select>
          </div>
          <div class="col-md-4 col-lg-3">
            <label class="form-label fw-semibold text-secondary small mb-1">
              <i class="bi bi-calendar-event me-1 text-primary"></i>Tanggal Absensi
            </label>
            <input type="date" class="form-control" name="tanggal" value="<%= tanggal %>" onchange="this.form.submit()">
          </div>
          <div class="col-md-3 col-lg-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-semibold px-4 d-inline-flex align-items-center justify-content-center">
              <i class="bi bi-search me-2"></i>Tampilkan
            </button>
            <% if (kelasId) { %>
            <a href="/absensi" class="btn btn-outline-secondary d-inline-flex align-items-center" title="Reset Filter">
              <i class="bi bi-arrow-counterclockwise"></i>
            </a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <% if (kelasId && siswaList.length > 0) { %>
    <% 
      const currentKelas = kelasList.find(k => k.id == kelasId);
      let countHadir = 0, countSakit = 0, countIzin = 0, countAlpha = 0;
      for (const s of siswaList) {
        const ex = absensiData[s.id];
        const st = ex ? ex.status : 'hadir';
        if (st === 'hadir') countHadir++;
        else if (st === 'sakit') countSakit++;
        else if (st === 'izin') countIzin++;
        else if (st === 'alpha') countAlpha++;
      }
    %>

    <!-- Live Counter Cards -->
    <div class="row g-2 g-md-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: 12px; border-left: 4px solid #10b981 !important;">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold">Hadir</div>
              <h3 class="fw-bold mb-0 text-success" id="counterHadir"><%= countHadir %></h3>
            </div>
            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
              <i class="bi bi-check-circle-fill fs-4"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: 12px; border-left: 4px solid #f59e0b !important;">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold">Sakit</div>
              <h3 class="fw-bold mb-0 text-warning" id="counterSakit"><%= countSakit %></h3>
            </div>
            <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
              <i class="bi bi-thermometer-half fs-4"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: 12px; border-left: 4px solid #06b6d4 !important;">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold">Izin</div>
              <h3 class="fw-bold mb-0 text-info" id="counterIzin"><%= countIzin %></h3>
            </div>
            <div class="rounded-circle p-2 bg-info bg-opacity-10 text-info">
              <i class="bi bi-file-text-fill fs-4"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: 12px; border-left: 4px solid #ef4444 !important;">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold">Alpha</div>
              <h3 class="fw-bold mb-0 text-danger" id="counterAlpha"><%= countAlpha %></h3>
            </div>
            <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
              <i class="bi bi-x-circle-fill fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Absensi Card -->
    <div class="card-custom shadow-sm border-0 mb-4">
      <div class="card-custom-header d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 py-3 px-4">
        <div>
          <h5 class="fw-bold mb-1">
            <i class="bi bi-card-checklist text-primary me-2"></i>
            Daftar Kehadiran Siswa • <%= currentKelas ? currentKelas.nama_kelas : ('Kelas #' + kelasId) %>
          </h5>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1">
            <i class="bi bi-calendar3 me-1"></i>
            <%= new Date(tanggal + 'T00:00:00').toLocaleDateString('id-ID', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
          </span>
          <span class="badge bg-secondary-subtle text-secondary ms-1 px-2 py-1">
            Total <%= siswaList.length %> Siswa
          </span>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-success fw-semibold" onclick="setAllStatus('hadir')">
            <i class="bi bi-check-all me-1"></i>Set Semua Hadir
          </button>
        </div>
      </div>

      <div class="card-custom-body p-0">
        <form action="/absensi" method="POST" id="formAbsensi">
          <input type="hidden" name="kelas_id" value="<%= kelasId %>">
          <input type="hidden" name="tanggal" value="<%= tanggal %>">

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="text-center" style="width: 50px;">No</th>
                  <th style="width: 140px;">NIS</th>
                  <th style="min-width: 200px;">Nama Siswa</th>
                  <th style="width: 70px;" class="text-center">L/P</th>
                  <th style="min-width: 320px;">Status Kehadiran</th>
                  <th style="min-width: 200px;">Keterangan</th>
                </tr>
              </thead>
              <tbody>
                <% for (let i = 0; i < siswaList.length; i++) { %>
                <% const s = siswaList[i] %>
                <% const existing = absensiData[s.id] %>
                <tr>
                  <td class="text-center text-muted fw-semibold"><%= i + 1 %></td>
                  <td>
                    <span class="badge bg-light text-dark border font-monospace px-2 py-1"><%= s.nis %></span>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= s.nama %></div>
                  </td>
                  <td class="text-center">
                    <% if (s.jenis_kelamin === 'L') { %>
                      <span class="badge bg-primary-subtle text-primary px-2 py-1" title="Laki-laki">L</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger px-2 py-1" title="Perempuan">P</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1.5 flex-wrap">
                      <% const statuses = [
                        ['hadir', 'success', 'check-circle', 'Hadir'],
                        ['sakit', 'warning', 'thermometer-half', 'Sakit'],
                        ['izin', 'info', 'file-text', 'Izin'],
                        ['alpha', 'danger', 'x-circle', 'Alpha']
                      ] %>
                      <% for (const [st, color, icon, label] of statuses) { %>
                      <div class="form-check absensi-radio m-0 p-0 me-1 mb-1">
                        <input class="form-check-input d-none status-radio" type="radio" 
                               name="absensi[<%= s.id %>][status]"
                               id="s<%= s.id %>_<%= st %>" value="<%= st %>"
                               onchange="updateCounters()"
                               <%= existing && existing.status === st ? 'checked' : (!existing && st === 'hadir' ? 'checked' : '') %>>
                        <label class="badge-status badge bg-<%= color %> text-<%= color === 'warning' ? 'dark' : 'white' %> px-2.5 py-1.5 d-inline-flex align-items-center"
                               for="s<%= s.id %>_<%= st %>">
                          <i class="bi bi-<%= icon %> me-1"></i><%= label %>
                        </label>
                      </div>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <input type="text" class="form-control form-control-sm"
                           name="absensi[<%= s.id %>][keterangan]"
                           value="<%= existing ? (existing.keterangan || '') : '' %>"
                           placeholder="Catatan (opsional)...">
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <div class="p-3 px-4 bg-light border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
            <div class="small text-muted">
              <i class="bi bi-info-circle me-1"></i>Pastikan seluruh status kehadiran siswa telah dicatat sebelum menyimpan.
            </div>
            <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm d-inline-flex align-items-center">
              <i class="bi bi-save me-2"></i>Simpan Absensi
            </button>
          </div>
        </form>
      </div>
    </div>

    <% } else if (kelasId) { %>
    <!-- State: Kelas Dipilih Tetapi Tidak Ada Siswa -->
    <div class="card-custom text-center py-5 shadow-sm border-0">
      <div class="card-custom-body">
        <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-muted">
          <i class="bi bi-people fs-1"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2">Belum Ada Siswa di Kelas Ini</h5>
        <p class="text-muted mb-4" style="max-width: 480px; margin: 0 auto;">
          Tidak ditemukan siswa aktif yang terdaftar pada kelas yang dipilih. Silakan tambahkan data siswa terlebih dahulu.
        </p>
        <a href="/siswa?kelas_id=<%= kelasId %>" class="btn btn-primary fw-semibold px-4">
          <i class="bi bi-person-plus me-2"></i>Kelola Siswa Kelas Ini
        </a>
      </div>
    </div>

    <% } else { %>
    <!-- State Awal: Belum Memilih Kelas -->
    <div class="card-custom text-center py-5 shadow-sm border-0">
      <div class="card-custom-body px-4">
        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex p-4 mb-3">
          <i class="bi bi-person-check fs-1"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">Mulai Pencatatan Absensi</h5>
        <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
          Pilih salah satu kelas di bawah ini atau gunakan filter di atas untuk menampilkan daftar siswa pada tanggal <strong><%= tanggal %></strong>.
        </p>

        <!-- Quick Class Selection Chips -->
        <div class="d-flex flex-wrap gap-2 justify-content-center" style="max-width: 720px; margin: 0 auto;">
          <% for (const k of kelasList) { %>
          <a href="/absensi?kelas_id=<%= k.id %>&tanggal=<%= tanggal %>" 
             class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1">
            <i class="bi bi-door-closed me-1"></i><%= k.nama_kelas %>
          </a>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script>
function updateCounters() {
  let hadir = 0, sakit = 0, izin = 0, alpha = 0;
  document.querySelectorAll('.status-radio:checked').forEach(radio => {
    if (radio.value === 'hadir') hadir++;
    else if (radio.value === 'sakit') sakit++;
    else if (radio.value === 'izin') izin++;
    else if (radio.value === 'alpha') alpha++;
  });

  const elHadir = document.getElementById('counterHadir');
  const elSakit = document.getElementById('counterSakit');
  const elIzin = document.getElementById('counterIzin');
  const elAlpha = document.getElementById('counterAlpha');

  if (elHadir) elHadir.textContent = hadir;
  if (elSakit) elSakit.textContent = sakit;
  if (elIzin) elIzin.textContent = izin;
  if (elAlpha) elAlpha.textContent = alpha;
}

function setAllStatus(status) {
  document.querySelectorAll(`.status-radio[value="${status}"]`).forEach(r => {
    r.checked = true;
  });
  updateCounters();
}

document.addEventListener('DOMContentLoaded', updateCounters);
</script>
