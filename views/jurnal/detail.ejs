<% layout('layouts/main') %>
<% const currentPage = 'jurnal' %>

<div class="content-page">
  <div class="container-fluid px-4">
    <div class="page-header">
      <div>
        <h4>Detail Jurnal Pembelajaran</h4>
      </div>
      <div class="d-flex gap-2">
        <a href="/jurnal/<%= jurnal.id %>/edit" class="btn btn-outline-primary">
          <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a href="/jurnal" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i>Kembali
        </a>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="card-custom">
          <div class="card-custom-header">
            <h5><i class="bi bi-journal-richtext me-2"></i><%= jurnal.materi %></h5>
          </div>
          <div class="card-custom-body">
            <div class="row g-3">
              <div class="col-md-3">
                <div class="detail-item">
                  <div class="detail-label">Tanggal</div>
                  <div class="detail-value"><%= new Date(jurnal.tanggal).toLocaleDateString('id-ID', {weekday:'long',year:'numeric',month:'long',day:'numeric'}) %></div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="detail-item">
                  <div class="detail-label">Kelas</div>
                  <div class="detail-value"><span class="badge bg-primary"><%= jurnal.nama_kelas %></span></div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="detail-item">
                  <div class="detail-label">Mata Pelajaran</div>
                  <div class="detail-value"><%= jurnal.nama_mapel || '-' %></div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="detail-item">
                  <div class="detail-label">Jam Ke</div>
                  <div class="detail-value">Jam ke-<%= jurnal.jam_ke %></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="detail-item">
                  <div class="detail-label">Guru</div>
                  <div class="detail-value"><%= jurnal.nama_guru %></div>
                </div>
              </div>
              <% if (jurnal.media_pembelajaran) { %>
              <div class="col-md-3">
                <div class="detail-item">
                  <div class="detail-label">Media</div>
                  <div class="detail-value"><%= jurnal.media_pembelajaran %></div>
                </div>
              </div>
              <% } %>
              <% if (jurnal.metode_pembelajaran) { %>
              <div class="col-md-3">
                <div class="detail-item">
                  <div class="detail-label">Metode</div>
                  <div class="detail-value"><%= jurnal.metode_pembelajaran %></div>
                </div>
              </div>
              <% } %>
            </div>

            <hr>

            <% if (jurnal.tujuan_pembelajaran) { %>
            <div class="mb-3">
              <h6 class="fw-bold text-primary"><i class="bi bi-bullseye me-2"></i>Tujuan Pembelajaran</h6>
              <p class="ms-4"><%= jurnal.tujuan_pembelajaran %></p>
            </div>
            <% } %>

            <% if (jurnal.kegiatan_pembelajaran) { %>
            <div class="mb-3">
              <h6 class="fw-bold text-success"><i class="bi bi-activity me-2"></i>Kegiatan Pembelajaran</h6>
              <p class="ms-4" style="white-space:pre-line"><%= jurnal.kegiatan_pembelajaran %></p>
            </div>
            <% } %>

            <% if (jurnal.catatan) { %>
            <div class="mb-3">
              <h6 class="fw-bold text-warning"><i class="bi bi-sticky me-2"></i>Catatan</h6>
              <p class="ms-4"><%= jurnal.catatan %></p>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
